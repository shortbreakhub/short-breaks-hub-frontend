# Optional GA4 configuration. Leave blank to disable analytics.
# Set this in the build environment; Vite embeds it at build time.
VITE_GA_MEASUREMENT_ID=

# Required to preserve the existing production API, maps and currency behavior.
# Configure GitHub Actions repository variables/secrets; do not commit .env.
VITE_API_BASE=
VITE_GOOGLE_MAP_GEOCODING_API_KEY=
VITE_GOOGLE_MAP_MAP_ID=
VITE_EXCHANGERATE_API_KEY=
# Optional legacy setting: both Abstract geolocation helpers are unimported.
VITE_ABSTRACT_GEOLOCATION_API_KEY=
# All VITE_* values are embedded in public browser assets, even when supplied
# through GitHub Secrets. Restrict provider keys at the provider.
